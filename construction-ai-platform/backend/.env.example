# Copy this file to ".env" and fill in your values. NEVER commit the real .env file.

# Multimodal LLM key (https://console.anthropic.com). Leave empty to run in DEMO mode.
ANTHROPIC_API_KEY=

# Model used for all modules
LLM_MODEL=claude-sonnet-5-5

# Set to 1 to force demo mode (sample outputs, no API calls) even if a key is present
DEMO_MODE=0

# Tuning
LLM_MAX_TOKENS=2500
LLM_TIMEOUT=60
MAX_IMAGE_MB=5

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
